{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.vscode-embedded-tools",
        "marus25.cortex-debug"
      ]
    }
  },
  "mounts": [
    "source=/dev,target=/dev,type=bind"
  ],
  "runArgs": [
    "--device-cgroup-rule=c *:* rmw",
    "--privileged",
    "--network=host"
  ]
}